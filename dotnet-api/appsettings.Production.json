{
  "_comment": "Production overrides — Docker PostgreSQL on server. Loaded when ASPNETCORE_ENVIRONMENT=Production.",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=afrobotics_bit;Username=bit_user;Password=bit_password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
